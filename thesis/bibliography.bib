@article{smith2007,
  author   = {Michael E. Smith},
  title    = {Form and Meaning in the Earliest Cities: A New Approach to Ancient Urban Planning},
  journal  = {Journal of Planning History},
  volume   = {6},
  number   = {1},
  pages    = {3-47},
  year     = {2007},
  doi      = {10.1177/1538513206293713},
  url      = { 
              https://doi.org/10.1177/1538513206293713
              },
  eprint   = { 
              https://doi.org/10.1177/1538513206293713
              },
  abstract = { This article describes a new model for urban planning in ancient and preindustrial cities that moves beyond the traditional simplistic dichotomy of planned versus organic cities. The model has two components: coordination of buildings and spaces, and standardization among cities. A variety of coordinated arrangements of buildings reflect urban planning, including simple coordination, formality and monumentality, orthogonal layouts, other forms of geometric order, and access and visibility (view-shed). Standardization among cities is analyzed in terms of architectural inventories, spatial patterns, orientation, and metrology. The political and social significance of ancient urban planning is then discussed using Amos Rapoport's model of levels of meaning in the built environment. }
}

